{
  "_comment": [
    "AWS ECS Fargate task definition for running update-intents on a schedule.",
    "",
    "Setup steps:",
    "  1. Build and push the Docker image (CI pushes <ECR_REPO_URI>:<GIT_SHA>):",
    "       docker build --platform linux/amd64 -f infra/ecs/Dockerfile -t <ECR_REPO_URI>:<GIT_SHA> .",
    "       docker push <ECR_REPO_URI>:<GIT_SHA>",
    "",
    "  2. Store secrets in AWS Secrets Manager:",
    "       aws secretsmanager create-secret --name orion/PRIVATE_KEY    --secret-string '0x...'",
    "       aws secretsmanager create-secret --name orion/RPC_URL_MAINNET --secret-string 'https://...'",
    "       aws secretsmanager create-secret --name orion/VAULT_ADDRESS   --secret-string '0xAAA...,0xBBB...'",
    "",
    "  3. Register this task definition (replace placeholders):",
    "       aws ecs register-task-definition --cli-input-json file://infra/ecs/task-definition.json",
    "",
    "  4. Create an ECS cluster (if you don't have one):",
    "       aws ecs create-cluster --cluster-name iorion-strategist-template",
    "",
    "  5. Create an EventBridge scheduled rule to run every 4 hours:",
    "       aws events put-rule \\",
    "         --name iorion-strategist-template \\",
    "         --schedule-expression 'cron(0 */4 * * ? *)' \\",
    "         --state ENABLED",
    "",
    "       aws events put-targets --rule iorion-strategist-template --targets '[{",
    "         \"Id\": \"iorion-strategist-template\",",
    "         \"Arn\": \"arn:aws:ecs:<REGION>:<ACCOUNT_ID>:cluster/iorion-strategist-template\",",
    "         \"RoleArn\": \"arn:aws:iam::<ACCOUNT_ID>:role/ecsEventsRole\",",
    "         \"RetryPolicy\": {",
    "           \"MaximumRetryAttempts\": 2,",
    "           \"MaximumEventAgeInSeconds\": 3600",
    "         },",
    "         \"DeadLetterConfig\": {",
    "           \"Arn\": \"arn:aws:sqs:<REGION>:<ACCOUNT_ID>:iorion-strategist-template-dlq\"",
    "         },",
    "         \"EcsParameters\": {",
    "           \"TaskDefinitionArn\": \"arn:aws:ecs:<REGION>:<ACCOUNT_ID>:task-definition/iorion-strategist-template\",",
    "           \"LaunchType\": \"FARGATE\",",
    "           \"NetworkConfiguration\": {",
    "             \"awsvpcConfiguration\": {",
    "               \"Subnets\": [\"<SUBNET_ID>\"],",
    "               \"SecurityGroups\": [\"<SG_ID>\"],",
    "               \"AssignPublicIp\": \"ENABLED\"",
    "             }",
    "           }",
    "         }",
    "       }]'",
    "",
    "     Note: ecsEventsRole must also have sqs:SendMessage on the DLQ.",
    "     Create the DLQ first:",
    "       aws sqs create-queue --queue-name iorion-strategist-template-dlq"
  ],
  "family": "iorion-strategist-template",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "update-intents",
      "image": "<ECR_REPO_URI>:<GIT_SHA>",
      "essential": true,
      "environment": [
        {
          "name": "HARDHAT_NETWORK",
          "value": "mainnet"
        }
      ],
      "secrets": [
        {
          "name": "PRIVATE_KEY",
          "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:orion/PRIVATE_KEY"
        },
        {
          "name": "RPC_URL_MAINNET",
          "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:orion/RPC_URL_MAINNET"
        },
        {
          "name": "VAULT_ADDRESS",
          "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:orion/VAULT_ADDRESS"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/iorion-strategist-template",
          "awslogs-region": "<REGION>",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
