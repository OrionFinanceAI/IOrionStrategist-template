{
  "name": "@orionfinanceai/iorion-strategist-template",
  "version": "1.0.0",
  "description": "Template for deploying and automating IOrionStrategist contracts against the Orion Finance protocol",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "compile": "hardhat compile",
    "deploy": "hardhat run scripts/deploy.ts",
    "update-intents": "hardhat run scripts/update-intents.ts",
    "test": "hardhat test",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@orion-finance/protocol": "github:OrionFinanceAI/protocol#23148945f35cb623f93fba5b6980c44a1473977c",
    "@openzeppelin/contracts": "^5.6.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.0.9",
    "@nomicfoundation/hardhat-verify": "^3.0.15",
    "@types/node": "^22.0.0",
    "dotenv": "^16.5.0",
    "ethers": "^6.15.0",
    "hardhat": "^3.4.1",
    "ts-node": "^10.9.2",
    "husky": "^9.1.7",
    "typescript": "^5.8.0"
  }
}
