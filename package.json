{
  "name": "@orionfinanceai/iorion-strategist-template",
  "version": "1.0.0",
  "description": "Template for deploying and automating IOrionStrategist contracts against the Orion Finance protocol",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "check": "npm run compile && npm run type-check",
    "compile": "hardhat compile",
    "type-check": "tsc --noEmit",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia",
    "deploy:mainnet": "hardhat run scripts/deploy.ts --network mainnet",
    "update-intents:sepolia:dry": "cross-env DRY_RUN=1 hardhat run scripts/update-intents.ts --network sepolia",
    "update-intents:sepolia": "hardhat run scripts/update-intents.ts --network sepolia",
    "update-intents:mainnet:dry": "cross-env DRY_RUN=1 hardhat run scripts/update-intents.ts --network mainnet",
    "update-intents:mainnet": "hardhat run scripts/update-intents.ts --network mainnet"
  },
  "dependencies": {
    "@orion-finance/protocol": "github:OrionFinanceAI/protocol#664f7a87ad1d8348599b47915df262e012e6cfad",
    "@orion-finance/plugins": "github:OrionFinanceAI/protocol-plugins#fe048dff2b5ca363f698dc88b7e24c1d50591863",
    "@openzeppelin/contracts": "^5.6.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.0.9",
    "cross-env": "^10.1.0",
    "@nomicfoundation/hardhat-verify": "^3.0.15",
    "@types/node": "^25.0.0",
    "dotenv": "^17.0.0",
    "ethers": "^6.15.0",
    "hardhat": "^3.4.1",
    "husky": "^9.1.7",
    "typescript": "^6.0.0"
  }
}
