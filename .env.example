# ─── Network ────────────────────────────────────────────────────────────────
# Chain-scoped RPC only (no bare RPC_URL / RPC_URL_*). Localhost is fixed in hardhat.config.
# Only networks with a URL (and a valid PRIVATE_KEY) are registered for deploy/update-intents.
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

# Private key of the account that deploys and owns the strategist contracts.
# This same account calls submitIntent() during rebalancing — it is the strategist owner.
PRIVATE_KEY=0x...

# ─── Etherscan verification (optional) ──────────────────────────────────────
# After deployment, deploy.ts prints `npx hardhat verify` commands.
# Running those commands submits the contract source code to Etherscan so that:
#   - anyone can read and audit the on-chain logic at etherscan.io
#   - the Etherscan UI shows a "Read/Write Contract" tab for direct interaction
#   - block explorers display the ABI and decode transaction calldata
# Get a free key at https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# ─── Orion Protocol ─────────────────────────────────────────────────────────
# Required. --network mainnet → MAINNET_ORION_CONFIG_ADDRESS;
# sepolia / hardhat / localhost → SEPOLIA_*. No ORION_CONFIG_ADDRESS. No defaults.
# SEPOLIA_ORION_CONFIG_ADDRESS=
#   Sepolia (comment only, never a code default): 0xbDe3025d08681a02a1c6cf70375baBe2152DD06f
# MAINNET_ORION_CONFIG_ADDRESS=

# Vault address(es) used by both deploy.ts and update-intents.ts.
#
# deploy.ts   — if set, the deployer (PRIVATE_KEY) must be this vault's manager.
#               After deploying exactly one strategist, calls
#               vault.updateStrategist(strategist). Leave blank to link later.
#
# update-intents.ts — required. Accepts a single address or a comma-separated
#               list of addresses; submitIntent() is called on each.
#
# Examples:
#   VAULT_ADDRESS=0xAAA...
#   VAULT_ADDRESS=0xAAA...,0xBBB...,0xCCC...
VAULT_ADDRESS=

# ─── Strategist parameters ───────────────────────────────────────────────────
# Number of top assets to select (uint16, range 1–65535). Defaults to 10.
STRATEGIST_K=10

# Which strategist contracts to deploy (comma-separated). Defaults to all three.
# Valid values: tvl, apy-equal, apy-weighted
# Examples:
#   DEPLOY_CONTRACTS=tvl
#   DEPLOY_CONTRACTS=apy-equal,apy-weighted
DEPLOY_CONTRACTS=tvl,apy-equal,apy-weighted

# Set to "1" to skip printing Etherscan verify commands after deployment.
SKIP_VERIFY=

# ─── Rebalancing ─────────────────────────────────────────────────────────────
# Set to "1" to simulate update-intents without sending any transactions.
DRY_RUN=

# Override ERC-165 interface ID check in update-intents (leave blank to use both defaults).
# Defaults: 0x2a588280 (full IOrionStrategist) or 0x2ba74b27 (functions only).
ORION_STRATEGIST_INTERFACE_ID=
